@page
@model AsignarTareaModel
@{
    ViewData["Title"] = "Asignar tarea";
}

<div class="mx-auto max-w-2xl">
    <a asp-page="/Index" class="btn btn-ghost mb-4 px-0">← Volver a las tareas</a>

    @if (TempData["Success"] is string mensaje)
    {
        <div class="alert alert-success mb-5" role="alert" data-testid="success-alert">
            <span>@mensaje</span>
        </div>
    }

    <section class="card border border-base-300 bg-base-100 shadow-xl">
        <div class="card-body">
            <div class="badge badge-primary badge-outline">Asignación</div>
            <h1 class="card-title mt-2 text-3xl">@Model.Tarea?.Titulo</h1>
            <p class="text-base-content/70">@Model.Tarea?.Descripcion</p>

            @if (Model.Tarea?.Estado == "Pendiente")
            {
                <form method="post" class="mt-5 space-y-5">
                    <input asp-for="TareaId" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-error" data-testid="validation-summary"></div>

                    <label class="form-control w-full">
                        <span class="label-text mb-2 font-semibold">Persona responsable</span>
                        <select asp-for="UsuarioId"
                                asp-items="Model.Usuarios"
                                class="select select-bordered w-full"
                                data-testid="assignee-select">
                            <option value="">Seleccione una persona</option>
                        </select>
                        <span asp-validation-for="UsuarioId" class="mt-1 text-sm text-error"></span>
                    </label>

                    <button type="submit" class="btn btn-primary w-full" data-testid="assign-submit">
                        Confirmar asignación
                    </button>
                </form>
            }
            else
            {
                <div class="alert alert-info mt-5">
                    <span data-testid="assigned-message">
                        Esta tarea está asignada a <strong>@Model.Tarea?.UsuarioAsignado</strong>.
                    </span>
                </div>
            }
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}


<!DOCTYPE html>
<html lang="es" data-theme="corporate">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sistema de Tareas</title>
    <link href="https://cdn.jsdelivr.net/npm/daisyui@5" rel="stylesheet" type="text/css" />
    <script src="https://cdn.jsdelivr.net/npm/@@tailwindcss/browser@4"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="min-h-screen bg-base-200 text-base-content">
    <header class="navbar border-b border-base-300 bg-base-100 px-4 md:px-10">
        <div class="flex-1">
            <a asp-page="/Index" class="text-xl font-bold tracking-tight">Tareas Barva</a>
        </div>
        <div class="badge badge-primary badge-outline">Demo académica</div>
    </header>

    <main class="mx-auto max-w-6xl p-4 md:p-10">
        @RenderBody()
    </main>

    <footer class="footer footer-center border-t border-base-300 bg-base-100 p-6 text-sm text-base-content/60">
        <p>Arquitectura de Software · Flujo crítico: asignar tarea</p>
    </footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

